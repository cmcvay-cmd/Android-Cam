<!-- activity_video_upload.xml -->
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VideoUploadActivity">

    <Button
        android:id="@+id/selectVideoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Video"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp" />

    <TextView
        android:id="@+id/selectedVideoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/selectVideoButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="No video selected" />

    <Button
        android:id="@+id/streamVideoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stream Video"
        android:layout_below="@id/selectedVideoText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

</RelativeLayout>