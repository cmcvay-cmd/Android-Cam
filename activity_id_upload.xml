<!-- activity_id_upload.xml -->
<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".IdUploadActivity">

    <Button
        android:id="@+id/selectIdButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select ID"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp" />

    <TextView
        android:id="@+id/selectedIdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/selectIdButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="No ID selected" />

    <Button
        android:id="@+id/verifyIdButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify ID"
        android:layout_below="@id/selectedIdText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp" />

</RelativeLayout>